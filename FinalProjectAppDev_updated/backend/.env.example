# Copy this file to .env in the same folder, then fill in YOUR OWN local values.
# Never commit the real .env file — it's already in .gitignore.

PORT=4000
CLIENT_ORIGIN=http://127.0.0.1:5500

DB_HOST=localhost
DB_PORT=3306
DB_USER=itern_app
DB_PASSWORD=changeme
DB_NAME=itern

JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# --- Gmail (real OTP emails) ---
# 1. Turn on 2-Step Verification on the Gmail account.
# 2. https://myaccount.google.com/apppasswords -> create an app password (16 letters).
# 3. Paste it below WITHOUT spaces. Your normal Gmail password will NOT work.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USER=yourname@gmail.com
EMAIL_PASS=abcdefghijklmnop
OTP_TTL_MINUTES=5

RESUME_UPLOAD_DIR=./uploads/resumes
PHOTO_UPLOAD_DIR=./uploads/photos
RESUME_MAX_MB=10
ML_SERVICE_URL=http://localhost:8000

# --- Admin (created automatically the first time the server starts) ---
# The admin approves new companies / school coordinators and can remove fake accounts.
# Log in at frontend/admin/login.html. After the first start you can delete these two lines.
ADMIN_EMAIL=keineeeee@gmail.com
ADMIN_PASSWORD=qsacesdz00

# Times in notifications / emails (default Asia/Manila)
APP_TIMEZONE=Asia/Manila
